# ---- OpenTofu ----
# Рабочий каталог инициализации (провайдеры + ссылки на модули), создаётся `tofu init`
stacks/*/.terraform/

# Секреты: значения переменных (один файл на все стеки) и путь к бэкенду
variables.tfvars
stacks/*/backend.tfvars

# Локальное состояние и его резервные копии (рабочий state лежит вне репозитория,
# в ~/.opentofu/shared-states/<стек>/)
stacks/*/*.tfstate
stacks/*/*.tfstate.*.backup

# Кэш скачивания плагинов: plugins/downloader кладёт архивы и распаковку в .tmp/ стека
# (<стек>/.tmp/<имя>.archive + <стек>/.tmp/extracted/<имя>)
stacks/*/.tmp*

